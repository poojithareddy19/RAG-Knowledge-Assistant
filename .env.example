# LLM provider. ollama needs no key and runs locally.

GENERATION__PROVIDER=ollama
GENERATION__MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Database. These match docker-compose.yml defaults.

DATABASE__URL=postgresql://gda:gda_local_pw@localhost:5432/gda
DATABASE__READONLY_URL=postgresql://gda_ro:gda_ro_pw@localhost:5432/gda

# Vector backend: faiss (local files) or pgvector (database)

VECTORSTORE__BACKEND=pgvector

# Optional, only if you switch providers later
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
